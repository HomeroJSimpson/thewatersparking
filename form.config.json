{
  "title": "The Waters Parking Violation Report",
  "intro": "Fill this form to submit a parking violation incident.",
  "emailTo": "developer@outlook.com",
  "emailSubject": "The Waters Parking Violation: {plate} {date} {time}",
  "sheetUrl": "",
  "hint": "On a phone, “Send report” opens your share sheet so you can pick Mail with the photo attached.",
  "buttons": {
    "send": "Send report",
    "copy": "Copy summary",
    "takePhoto": "Take a photo",
    "retakePhoto": "Retake photo",
    "removePhoto": "Remove photo"
  },
  "messages": {
    "missing": "Please fill in: {fields}",
    "sending": "Sending…",
    "sentSheet": "Sent to the sheet. Thank you!",
    "shared": "Shared. Thank you!",
    "opening": "Opening your email app…",
    "cancelled": "Cancelled.",
    "failed": "Couldn’t send. Check your connection and try again.",
    "copied": "Summary copied.",
    "copyFailed": "Couldn’t copy on this browser.",
    "attachManually": "(Attach your photo manually in this email.)"
  },
  "fields": [
    {
      "id": "name",
      "type": "text",
      "label": "Your name",
      "required": true,
      "autocomplete": "name"
    },
    {
      "id": "date",
      "type": "date",
      "label": "Date",
      "required": true,
      "default": "now"
    },
    {
      "id": "time",
      "type": "time",
      "label": "Time",
      "required": true,
      "default": "now"
    },
    {
      "id": "parking-permit",
      "type": "text",
      "digitsOnly": true,
      "maxlength": 2,
      "label": "The Waters parking permit number",
      "placeholder": "e.g. 99"
    },
    {
      "id": "plate",
      "type": "text",
      "uppercase": true,
      "label": "Vehicle license plate",
      "maxlength": 7,
      "required": true,
      "placeholder": "e.g. 1ABC234"
    },
    {
      "id": "state",
      "type": "text",
      "uppercase": true,
      "label": "State",
      "maxlength": 2,
      "required": true,
      "placeholder": "e.g. CA, NV, etc.",
      "default": "CA"
    },
    {
      "id": "notes",
      "type": "text",
      "label": "Notes",
      "maxlength": 140
    },
    {
      "id": "reasons",
      "type": "checkbox",
      "label": "Vehicle improperly parked due to (check all that apply)",      
      "required": true,
      "options": [
        "Vehicle has NO VALID PARKING PERMIT",
        "Parked in DISABLED PERSONS' space/area",
        "Parked in NO PARKING space/area",
        "Parked in RESERVED OR DESIGNATED space/area",
        "Parked in 2 SPACES",
        "Blocking DRIVEWAY OR ACCESS"
      ]
    },
    {
      "id": "photo",
      "type": "photo",
      "label": "Photo",
      "required": false
    }
  ]
}